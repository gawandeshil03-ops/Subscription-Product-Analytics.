      <aliases enabled="yes"/>
      <column caption="Conversion Rate" datatype="real" name="[Calculation_3207576635461636]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([converted]) / COUNT([converted])"/>
      </column>
      <column caption="Churn Rate" datatype="real" name="[Calculation_3207576690454537]" role="measure" type="quantitative">
        <calculation class="tableau" formula="1-AVG([retained])"/>
      </column>
      <column caption="MRR Lost" datatype="real" default-format="c&quot;$&quot;#,##0;-&quot;$&quot;#,##0" name="[Calculation_3207576694972426]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [converted] = 1 AND [retained] = 0 THEN&#10;    [monthly_price]&#10;ELSE&#10;    0&#10;END"/>
      </column>
      <column caption="Churned" datatype="integer" name="[Calculation_3207576697085963]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [converted]=1 AND [retained]=0 THEN 1 &#10;ELSE 0 &#10;END"/>
      </column>
      <column caption="Plan Churned Rate" datatype="real" name="[Calculation_3207576697315340]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Calculation_3207576697085963]) / SUM([converted])"/>
      </column>
      <column caption="Conversion Lift" datatype="real" name="[Calculation_3207576726454287]" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ FIXED :&#10;AVG(&#10;IF [variant] = &quot;B&quot; THEN [converted] END&#10;)&#10;}&#10;-&#10;{ FIXED :&#10;AVG(&#10;IF [variant] = &quot;A&quot; THEN [converted] END&#10;)&#10;}"/>
      </column>
